# Per-user Xcode project data and local schemes
*.xcuserdatad/
*.xccheckout
*.xcscmblueprint

# Per-developer Xcode state: window layout, breakpoints, scheme ordering.
# Nothing here affects a build, and it conflicts on every pull.
xcuserdata/

