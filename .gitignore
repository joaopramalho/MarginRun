*.tmp
*.temp
*.swp
*.swo
.AppleDouble
.LSOverride
._*
.Spotlight-V100/
.Trashes/
.fseventsd/

# Generated screenshots. The light/ and dark/ catalogues are reproducible with
# `xcodebuild test -only-testing:MarginRunUITests/ScreenshotCatalog`, and the
# App Store captures are marketing assets that belong outside the source tree.
Screenshots/
Screenshots.zip
